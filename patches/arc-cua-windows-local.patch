+def send_unicode_text(text: str) -> None:
+    """Type `text` as one SendInput batch of KEYEVENTF_UNICODE events.
+
+    pywinauto maps characters through the active keyboard layout (AltGr chords on
+    German layouts), which dropped or repeated characters in Windows 11 Notepad.
+    Unicode events carry no modifiers, so the layout cannot corrupt them.
+    """
+    import ctypes
+    from ctypes import wintypes
+
+    class KEYBDINPUT(ctypes.Structure):
+        _fields_ = [("wVk", wintypes.WORD), ("wScan", wintypes.WORD), ("dwFlags", wintypes.DWORD),
+                    ("time", wintypes.DWORD), ("dwExtraInfo", ctypes.c_size_t)]
+
+    class _U(ctypes.Union):  # sized for MOUSEINPUT, the largest member
+        _fields_ = [("ki", KEYBDINPUT), ("_pad", ctypes.c_byte * 32)]
+
+    class INPUT(ctypes.Structure):
+        _fields_ = [("type", wintypes.DWORD), ("u", _U)]
+
+    keyup, unicode = 0x0002, 0x0004
+    events: list[INPUT] = []
+
+    def add(vk: int, scan: int, flags: int) -> None:
+        for extra in (0, keyup):
+            item = INPUT(type=1)
+            item.u.ki = KEYBDINPUT(vk, scan, flags | extra, 0, 0)
+            events.append(item)
+
+    for char in text.replace("\r\n", "\n"):
+        if char == "\n":
+            add(0x0D, 0, 0)
+        elif char == "\t":
+            add(0x09, 0, 0)
+        else:
+            data = char.encode("utf-16-le")
+            for i in range(0, len(data), 2):  # surrogate pairs become two events
+                add(0, int.from_bytes(data[i:i + 2], "little"), unicode)
+    if not events:
+        return
+    array = (INPUT * len(events))(*events)
+    sent = ctypes.windll.user32.SendInput(len(events), array, ctypes.sizeof(INPUT))
+    if sent != len(events):
+        raise TargetUnavailable(f"SendInput delivered {sent} of {len(events)} key events")
+
+
