+    def __init__(self, element: Any, uia: Any) -> None:
+        from types import SimpleNamespace
+
+        self._e, self._uia = element, uia
+        d, get = uia.UIA_dll, element.GetCachedPropertyValue
+        self._get, self._d = get, d
+        self.element_info = SimpleNamespace(
+            runtime_id=tuple(get(d.UIA_RuntimeIdPropertyId) or ()),
+            control_type=uia.known_control_type_ids.get(element.CachedControlType, str(element.CachedControlType)),
+            name=element.CachedName or "", automation_id=element.CachedAutomationId or "",
+            element=SimpleNamespace(CurrentIsPassword=bool(element.CachedIsPassword),
+                                    CurrentHasKeyboardFocus=bool(element.CachedHasKeyboardFocus),
+                                    CurrentIsKeyboardFocusable=bool(element.CachedIsKeyboardFocusable)))
+
+    def rectangle(self) -> Any:
+        from types import SimpleNamespace
+
+        r = self._e.CachedBoundingRectangle
+        return SimpleNamespace(left=r.left, top=r.top, width=lambda: r.right - r.left, height=lambda: r.bottom - r.top)
+
+    def is_visible(self) -> bool:
+        return not self._e.CachedIsOffscreen
+
+    def is_enabled(self) -> bool:
+        return bool(self._e.CachedIsEnabled)
