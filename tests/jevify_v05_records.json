    "TYPE_TEXT 'Full name' = 'Erika Mustermann' +TAB conf=0.83",
    "TYPE_TEXT 'Work email' = 'erika@example.com' +TAB conf=0.52",
    "SET_VALUE 'Team' = 'Engineering' conf=0.80",
    "SET_VALUE 'Start date' = '2026-11-02' conf=0.65",
    "SET_VALUE 'Years of experience' = '5' conf=0.67",
