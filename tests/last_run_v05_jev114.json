   "status": "SUBTASK_COMPLETE",
   "reason": null,
   "needs_input": null,
   "actions": 8,
   "steps": [
    "TYPE_TEXT 'Full name' = 'Erika Mustermann' +TAB conf=0.81",
    "TYPE_TEXT 'Work email' = 'erika@example.com' +TAB conf=0.80",
    "SET_VALUE 'Team' = 'Engineering' conf=0.72",
    "SET_VALUE 'Start date' = '2026-11-02' conf=0.86",
    "SET_VALUE 'Years of experience' = '5' conf=0.76",
    "CLICK 'Team' conf=0.99",
    "CLICK 'Send me product updates' conf=0.95",
    "CLICK 'Create account' conf=0.95"
   ],
   "page": {
    "url": "http://127.0.0.1:8765/signup.html",
    "title": "Team Signup"
   },
   "check": true,
   "sec": {
    "setup": 0.75,
    "run": 5.3
   },
   "wall": 6.77
  }
 },
