     "Plan Team is selected",
     "The product updates checkbox is checked",
     "The page says Account created"
    ],
    "max_actions": 15,
    "allowed_risks": [
     "send"
    ]
   },
   "check": "(()=>{const s=window.__submitted; return !!s && String(s.name)===String(\"Erika Mustermann\") && String(s.email)===String(\"erika@example.com\") && String(s.team)===String(\"Engineering\") && String(s.start)===String(\"2026-11-02\") && String(s.experience)===String(5) && String(s.plan)===String(\"team\") && String(s.updates)===String(true)})()"
  },
  "result": {
   "type": "result",
   "target": "browser",
   "status": "SUBTASK_COMPLETE",
   "reason": null,
   "needs_input": null,
   "actions": 8,
   "steps": [
    "TYPE_TEXT 'Full name' = 'Erika Mustermann' +TAB conf=0.81",
    "TYPE_TEXT 'Work email' = 'erika@example.com' +TAB conf=0.60",
    "SET_VALUE 'Team' = 'Engineering' conf=0.78",
    "SET_VALUE 'Start date' = '2026-11-02' conf=0.71",
    "SET_VALUE 'Years of experience' = '5' conf=0.71",
    "CLICK 'Team' conf=0.98",
    "CLICK 'Send me product updates' conf=0.94",
    "CLICK 'Create account' conf=0.99"
   ],
   "page": {
    "url": "http://127.0.0.1:8765/signup.html",
    "title": "Team Signup"
   },
   "check": true,
   "sec": {
    "setup": 0.66,
    "run": 5.53
   },
   "wall": 6.86
  }
 },
