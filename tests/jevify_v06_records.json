{
 "B1_signup": {
  "expected": "complete",
  "req": {
   "target": "browser",
   "url": "http://127.0.0.1:8765/signup.html",
   "subtask": {
    "goal": "Create the team account with the supplied details, plan Team, and opt in to product updates",
    "inputs": {
